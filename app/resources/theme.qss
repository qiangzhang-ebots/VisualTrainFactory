QTableWidget {
  background-color: #0f172a;
  color: #f8fafc;
  gridline-color: #334155;
  alternate-background-color: #111827;
}
QHeaderView::section {
  background-color: #1e293b;
  color: #f8fafc;
  border: 1px solid #334155;
  padding: 4px;
}
QTableWidget::item:selected {
  background: #2563eb;
  color: #ffffff;
}
QListWidget {
  background: #071027;
  color: #f8fafc;
  padding: 4px;
}
QListWidget::item {
  margin-bottom: 4px;
}
QTabWidget#keypointTabWidget::pane {
  border: none;
  background-color: #0f1729;
}
QTabWidget#keypointTabWidget QStackedWidget {
  background: transparent;
}
QPushButton#btnAddKeypointRow {
  background-color: #2563eb;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  padding: 4px 14px;
  font-size: 12px;
}
QPushButton#btnAddKeypointRow:hover {
  background-color: #1d4ed8;
}
QPushButton#btnAddKeypointRow:pressed {
  background-color: #1e40af;
}
